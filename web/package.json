{
  "name": "partsource-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist test-results playwright-report",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/poc/test-bundle.ts && tsx scripts/poc/test-resolver.ts && tsx scripts/poc/test-url-state.ts",
    "test:documents": "tsx scripts/poc/test-documents.ts",
    "test:boundary": "tsx scripts/poc/test-boundary.ts",
    "release:audit": "npm run lint && npm test && npm run test:documents && npm run build && npm run test:browser && npm run test:boundary",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
